{
    "name": "warete/moonshine-fullcalendar-resource",
    "description": "FullCalendarJS integration for MoonShine admin panel",
    "keywords": ["moonshine", "resource", "calendar", "fullcalendar"],
    "type": "library",
    "homepage": "https://getmoonshine.app",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/warete/moonshine-fullcalendar-resource/issues",
        "source": "https://github.com/warete/moonshine-fullcalendar-resource"
    },
    "authors": [
        {
            "name": "Egor Borisovsky",
            "email": "egor.borisovskiy@gmail.com",
            "homepage": "https://github.com/warete"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0",
        "rector/rector": "^1.0",
        "moonshine/moonshine": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.92"
    },
    "autoload": {
        "psr-4": {
            "Warete\\MoonShineFullCalendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Warete\\MoonShineFullCalendar\\Tests\\": "tests/",
            "Warete\\MoonShineFullCalendar\\Database\\Factories\\": "database/factories/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --clear-cache",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "extra": {
        "laravel": {
            "providers": [
              "Warete\\MoonShineFullCalendar\\Providers\\FullCalendarServiceProvider"
            ]
        }
    }
}
